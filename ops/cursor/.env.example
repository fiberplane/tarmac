# Host-only Cursor credentials. Do not commit ops/cursor/.env.
CURSOR_API_KEY=

# Cursor launch defaults for local Tarmac experiments.
CURSOR_REPO_URL=https://github.com/fiberplane/tarmac
CURSOR_BASE_REF=main
CURSOR_MODEL=composer-2
CURSOR_AUTO_CREATE_PR=true

# FP REST/no-clone context passed to Cursor workers as Cursor-managed secrets.
FP_REMOTE=rest-api
FP_WORKSPACE=fiberplane
FP_PROJECT_ID=proj_01KSJF642C8WVFV6P2S9EBM6X9
FP_PROJECT_PREFIX=TARM
FP_SERVER_URL=
FP_TOKEN=
